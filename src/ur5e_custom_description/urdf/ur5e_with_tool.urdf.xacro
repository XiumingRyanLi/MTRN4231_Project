<?xml version="1.0"?>
<robot name="ur5e_with_tool" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ====== Common wrapper args (mirror your current wrapper) ====== -->

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>

  <!-- UR config file args (same names you were passing in launch) -->
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/ur5e/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"  default="$(find ur_description)/config/ur5e/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"    default="$(find ur_description)/config/ur5e/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"      default="$(find ur_description)/config/ur5e/visual_parameters.yaml"/>

  <!-- safety params (same names) -->
  <xacro:arg name="safety_limits"     default="true"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- (Optional, ignored by UR xacro, kept for compatibility) -->
  <xacro:arg name="robot_ip" default="192.168.0.100"/>

  <!-- ====== Include the UR base (from ur_description) ====== -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <xacro:ur_robot
      name="${name}"
      ur_type="${ur_type}"
      joint_limit_params="${joint_limit_params}"
      kinematics_params="${kinematics_params}"
      physical_params="${physical_params}"
      visual_params="${visual_params}"
      safety_limits="${safety_limits}"
      safety_pos_margin="${safety_pos_margin}"
      safety_k_position="${safety_k_position}"
  />

  <!-- ====== Include your end effector ====== -->
  <!-- If your EE lives in a separate package, keep this include: -->
  <xacro:include filename="$(find end_effector_description)/urdf/end_effector.urdf"/>

  <!-- If your EE xacro defines a known root link (e.g., 'ee_body'), keep it here.
       Otherwise, change ee_root_link's default to your actual EE root link. -->
  <!-- <xacro:arg name="ee_root_link" default="ee_body"/> -->

  <!-- ====== Mount: UR 'tool0' -> EE root link ====== -->
  <!-- Coupler joint: tool0 -> ee_mount (rename child if your root link differs) -->
  <joint name="ee_coupler_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="ee_mount"/>
    <!-- Adjust if your STL needs an offset/rotation relative to tool0 -->
    <origin xyz="0 0 0.10" rpy="0 ${pi} 0"/>
  </joint>
</robot>



