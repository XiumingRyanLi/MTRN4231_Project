<?xml version="1.0"?>
<robot name="simple_claw">

  <!-- Root that will attach to tool0 -->
  <link name="ee_mount">
    <visual>
      <!-- tweak the pose so the STL lines up with tool0 -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- scale=0.001 assumes the STL is in millimetres -->
        <mesh filename="package://end_effector_description/meshes/claw_assembly.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- optional: use a simpler collision shape for faster planning -->
    <collision>
      <origin xyz="0 -0.015 0.01" rpy="0 0 0"/>
      <geometry>
        <!-- start simple; refine later -->
        <box size="0.06 0.083 0.112"/>
      </geometry>
    </collision>
  </link>

</robot>
