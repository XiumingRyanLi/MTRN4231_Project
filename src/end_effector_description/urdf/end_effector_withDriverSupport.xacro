<?xml version="1.0"?>
<robot name="end_effector_withDriverSupport" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- === UR arm (set the args the UR xacro expects) === -->
  <xacro:arg name="name" default="ur5e"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  <!-- Use find-pkg-share on ROS 2 -->
  <xacro:include filename="$(find-pkg-share ur_description)/urdf/ur.urdf.xacro"/>

  <!-- Instantiate the UR with empty prefix (tool0, flange, etc. will exist) -->
  <xacro:ur_robot name="$(arg name)" ur_type="$(arg ur_type)" prefix=""/>

  <!-- === End-effector macro (visual + collision) === -->
  <xacro:include filename="$(find-pkg-share end_effector_description)/urdf/end_effector.urdf.xacro"/>

  <!-- Mount the gripper directly to tool0. Adjust pose as needed. -->
  <xacro:end_effector prefix="" parent="tool0"/>

  

</robot>
