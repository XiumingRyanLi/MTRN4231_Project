Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
Visualization Manager:
  Global Options:
    Fixed Frame: base_link
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Cell Size: 0.2
      Plane: XY
    - Class: rviz/TF
      Name: TF
      Show Names: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Robot Description: robot_description
      Planning Scene Topic: /planning_scene
      Move Group Namespace: ""              # default
      MoveIt Monitored Planning Scene: true
      Planned Path:
        Link Color Enabled: true
        Robot Alpha: 0.5
        Show Robot Visual: true
        Show Trail: false
      Planning Request:
        Planning Group: manipulator         # <- default group from ur_moveit_config
        Query Goal State: false
        Query Start State: false
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.8
      Pitch: 0.6
      Yaw: 1.0
