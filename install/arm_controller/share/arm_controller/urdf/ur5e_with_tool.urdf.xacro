<?xml version="1.0"?>
<robot name="ur5e_with_tool" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Required args so ur_description's xacro doesn't error -->
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>

  <!-- UR5e -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <!-- End effector (your package + URDF) -->
  <xacro:include filename="$(find end_effector_description)/urdf/end_effector.urdf"/>

  <!-- Coupler joint: tool0 -> ee_mount (rename child if your root link differs) -->
  <joint name="ee_coupler_joint" type="fixed">
    <parent link="tool0"/>
    <child  link="ee_mount"/>
    <!-- Adjust if your STL needs an offset/rotation relative to tool0 -->
    <origin xyz="0 0 0.10" rpy="0 ${pi} 0"/>
  </joint>

</robot>
