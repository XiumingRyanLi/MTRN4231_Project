<?xml version="1.0"?>
<robot name="end_effector" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Constants -->
  <xacro:property name="scale_factor" value="0.001"/>
  <xacro:property name="mass_value" value="0.5"/>
  <xacro:property name="inertia_value" value="1.0"/>

  <!-- Helper: mesh link with inertial -->
  <xacro:macro name="add_mesh_link" params="link_name mesh_path">
    <link name="${link_name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_path}" scale="${scale_factor} ${scale_factor} ${scale_factor}"/>
        </geometry>
      </visual>

      <!-- Use a simple box for collision (faster & more robust than STL) -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <!-- tune these to roughly bound your gripper -->
          <box size="0.06 0.09 0.11"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass_value}"/>
        <inertia ixx="${inertia_value}" ixy="0" ixz="0"
                 iyy="${inertia_value}" iyz="0"
                 izz="${inertia_value}"/>
      </inertial>
    </link>
  </xacro:macro>


  <!-- Main end-effector macro -->
  <xacro:macro name="end_effector" params="prefix parent">
    <xacro:add_mesh_link
      link_name="${prefix}gripper"
      mesh_path="package://end_effector_description/meshes/claw_assembly.stl"/>

    <!-- Mount to the parent (e.g., tool0). Adjust pose to suit your CAD. -->
    <joint name="${prefix}gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}gripper"/>
      <!-- Example pose: 67 mm forward, rotate as needed -->
      <origin xyz="0 0 0.067" rpy="0 ${pi} 0"/>
    </joint>
  </xacro:macro>

</robot>
